# Copy to .env and replace both placeholders with separate random values.
SECRET_KEY=replace-with-a-random-django-secret
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=stride
POSTGRES_USER=stride
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,django
TIME_ZONE=UTC
DJANGO_PORT=8001
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
